# Database
DATABASE_URL=postgres://user:password@localhost:5432/neyome

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google Sign-In (Flutter). Audience of the ID token posted to POST /auth/login/google.
GOOGLE_WEB_CLIENT_ID=461238717581-kus9cn1nqgcm7smhoo0kf409t1f3f08s.apps.googleusercontent.com

# Admin dashboard session (longer than app users; e.g. 30d, 90d, 365d)
ADMIN_JWT_EXPIRES_IN=30d

# Application
# Public API origin used in avatar URLs, magic links, etc.
# Production MUST be the real API host (e.g. https://api.neyome.com), never localhost.
APP_BASE_URL=http://localhost:3000
# Optional override for client-facing URLs (preferred over APP_BASE_URL for avatars)
# PUBLIC_BASE_URL=https://api.neyome.com
# Mobile clients must send this value in the x-api-key header.
API_KEY=your-api-key

# Local file uploads (avatars served at /uploads/avatars)
UPLOADS_DIR=uploads

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Admin seed (npm run seed:admin)
ADMIN_EMAIL=admin@neyome.com
ADMIN_PASSWORD=Admin123!ChangeMe

# Admin dashboard CORS
ADMIN_CORS_ORIGINS=http://localhost:3001

# Public frontend CORS (landing page, app)
FRONTEND_CORS_ORIGINS=https://neyome.com

# SMTP (password reset + email change OTP)
# Hostinger Email: smtp.hostinger.com, port 465 + SMTP_SECURE=true (or 587 + false).
# Other providers: smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net, etc.
# Placeholder smtp.example.com disables outbound email until real values are set.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Support@neyome.com
SMTP_PASS=
SMTP_FROM=Support@neyome.com
APP_NAME=Neyome

# Optional: Node environment
NODE_ENV=development
