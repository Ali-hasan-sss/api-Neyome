# Database
DATABASE_URL=postgres://user:password@localhost:5432/neyome

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin dashboard session (longer than app users; e.g. 30d, 90d, 365d)
ADMIN_JWT_EXPIRES_IN=30d

# Application
APP_BASE_URL=http://localhost:3000
API_KEY=your-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Admin seed (npm run seed:admin)
ADMIN_EMAIL=admin@neyome.com
ADMIN_PASSWORD=Admin123!ChangeMe

# Admin dashboard CORS
ADMIN_CORS_ORIGINS=http://localhost:3001

# SMTP (password reset + email change OTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@neyome.com
APP_NAME=Neyome

# Optional: Node environment
NODE_ENV=development
